# ── База данных ─────────────────────────────────────────────────
# На Netlify строка подставляется автоматически (NETLIFY_DB_URL).
# Локально можно указать любую Postgres-строку (или использовать netlify dev,
# который поднимет локальную БД сам).
DATABASE_URL=

# ── Безопасность ────────────────────────────────────────────────
# Секрет для подписи сессий (JWT). Минимум 16 символов.
# Сгенерировать: openssl rand -base64 48
AUTH_SECRET=

# Публичный адрес сайта (для метаданных и cookie-флагов).
NEXT_PUBLIC_APP_URL=http://localhost:3000
