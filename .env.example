# ── База данных (Supabase Postgres) ─────────────────────────────
# Pooled connection string из Supabase → Project Settings → Database →
# Connection pooling → "Connection string" (порт 6543, режим Transaction).
DATABASE_URL=

# Прямое подключение (порт 5432, Session mode) — нужно только для миграций.
# Если пусто, миграции пойдут через DATABASE_URL.
DIRECT_URL=

# ── Безопасность ────────────────────────────────────────────────
# Секрет для подписи сессий (JWT). Минимум 16 символов.
# Сгенерировать: openssl rand -base64 48
AUTH_SECRET=

# Публичный адрес сайта (для метаданных и cookie-флагов).
NEXT_PUBLIC_APP_URL=http://localhost:3000
